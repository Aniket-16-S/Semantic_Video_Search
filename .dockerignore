# ==============================================================================
# .dockerignore — Semantic Video Search Engine
# ==============================================================================
# Docker builds the Python FastAPI backend only.
# Flutter/Dart, native FFmpeg static libraries, and dev tooling are excluded —
# the container installs system ffmpeg via apt-get instead.
# ==============================================================================

# ── Version Control ───────────────────────────────────────────────────────────
.git
.gitignore
.github

# ── IDEs & Development Clutter ───────────────────────────────────────────────
.vs
.vscode
.idea
*.suo
*.user
*.sln

# ── Python Cache & Virtual Environments ──────────────────────────────────────
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.env
.env.*
pip-wheel-metadata/
*.egg-info/

# ── Jupyter & Debug Scripts ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
debug_siglip.py
verify_setup.py
check_qdrant.py
test_qdrant_data.py
test_open.py
test_inference.py
project_state_summary.md

# ── Dart / Flutter (not used inside Docker) ───────────────────────────────────
media_core_ffi/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# ── FFmpeg Static Libs & Source Tree (Docker uses apt-get ffmpeg instead) ─────
# These are large binary trees only needed for the Dart/Flutter native build.
native/
ffmpeg-6.1.1/
ffmpeg-6.1.1.tar.bz2

# ── Large Model Assets (excluded — mount as volumes or build separately) ──────
models/
raw_models/
assets/models/

# ── Temporary & Runtime Folders ───────────────────────────────────────────────
temp_uploads/
scratch/
qdrant_local_db/
openvino_cache/

# ── PaddleOCR Archives ────────────────────────────────────────────────────────
*.tar
en_PP-OCRv4_det_infer/
en_PP-OCRv4_rec_infer/
*.pdmodel
*.pdiparams
*.pdiparams.info

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── OS Artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
