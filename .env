# ── Qdrant connection ─────────────────────────────────────────────────────────
# QDRANT_USE_SERVER=false (default) → uses LOCAL EMBEDDED mode.
#   No Docker needed. Data stored in qdrant_local_db/ at the project root.
#   This is the recommended mode for development — zero timeouts, zero setup.
#
# QDRANT_USE_SERVER=true → connects to Qdrant HTTP server at QDRANT_HOST:QDRANT_PORT.
#   Use this when running docker-compose up.
QDRANT_USE_SERVER=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=video_embeddings

# ── Other ─────────────────────────────────────────────────────────────────────
USE_CUDA=true

# ── Model mode ────────────────────────────────────────────────────────────────
# Controls which ONNX inference mode the engine uses.
#
#   (unset / commented out) → AUTO: split models used if both files exist on disk,
#                             combined model_quantized.onnx used otherwise.
#   USE_SPLIT_MODELS=true   → FORCE SPLIT: raises FileNotFoundError at startup
#                             if vision_encoder_int8.onnx or text_encoder_int8.onnx
#                             are missing. Run tools/export_split_models.py first.
#   USE_SPLIT_MODELS=false  → FORCE COMBINED: always use model_quantized.onnx,
#                             even if split files are present on disk.
#
# USE_SPLIT_MODELS=false

# ── OpenVINO (optional) ───────────────────────────────────────────────────────
# Only used when the OpenVINO runtime is installed and detected automatically.
# Uncomment to override the target device (default: GPU_FP16).
# OPENVINO_DEVICE=CPU_FP32
# OPENVINO_CACHE_DIR=.openvino_cache

# ── Phase 1: SigLIP Model Tier ────────────────────────────────────────────────
# Controls which SigLIP model variant is used for frame embedding and search.

# SIGLIP_TIER=base  (default)
#     Model  : google/siglip-base-patch16-224
#     Size   : ~26 MB per encoder (split mode)
#     Generate: python tools/export_split_models.py
#
#   SIGLIP_TIER=hq
#     Model  : google/siglip-so400m-patch14-224 (SO400M — higher quality)
#     Size   : ≤ 300 MB (vision encoder)
#     Generate: python tools/quantize_siglip.py --tier hq
#
# ⚠  IMPORTANT: Switching tiers requires re-indexing ALL media.
#    Embeddings from different tiers are NOT compatible with each other.
#
SIGLIP_TIER=hq

# ── Phase 1: Native C Library Build (media_core_ffi) ─────────────────────────
# Set these before running `flutter build` or `flutter run`.
# The Flutter Native Assets build.dart script reads these to locate FFmpeg libs.
#
# Windows (MinGW static FFmpeg):
FFMPEG_WINDOWS_X64_DIR=c:\AI Projects\Semantic_Video_Search\native\windows\x64

# Android (NDK cross-compiled FFmpeg):
FFMPEG_ANDROID_ARM64_DIR=c:\AI Projects\Semantic_Video_Search\native\android\arm64
ANDROID_NDK_HOME=C:\Users\anike\AppData\Local\Android\Sdk\ndk\26.3.11579264
